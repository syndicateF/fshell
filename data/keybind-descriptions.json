{
    "__comment": "Keybind description patterns for x-shell. Edit this file to customize descriptions.",
    "transforms": {
        "direction": {
            "l": "left",
            "r": "right",
            "u": "up",
            "d": "down"
        },
        "groupDirection": {
            "f": "forward",
            "b": "backward"
        }
    },
    "dispatchers": {
        "workspace": {
            "__default": "Go to workspace {arg}",
            "+1": "Next workspace",
            "-1": "Previous workspace"
        },
        "movetoworkspace": {
            "__default": "Move window to workspace {arg}",
            "+1": "Move window to next workspace",
            "-1": "Move window to previous workspace"
        },
        "movetoworkspacesilent": {
            "__default": "Move window silently to workspace {arg}",
            "+1": "Move window to next workspace (silent)",
            "-1": "Move window to previous workspace (silent)"
        },
        "togglespecialworkspace": "Toggle special workspace {arg|scratchpad}",
        "killactive": "Close active window",
        "closewindow": "Close window: {arg}",
        "fullscreen": {
            "__default": "Toggle fullscreen",
            "0": "Toggle fullscreen",
            "1": "Toggle maximize",
            "2": "Toggle fake fullscreen"
        },
        "togglefloating": "Float/unfloat window",
        "setfloating": "Set window floating",
        "settiled": "Set window tiled",
        "pseudo": "Toggle pseudo-tiling",
        "pin": "Pin window (show on all workspaces)",
        "centerwindow": "Center window",
        "focuswindow": "Focus window: {arg}",
        "movefocus": "Move focus {arg:direction}",
        "movewindow": "Move window {arg:direction}",
        "swapwindow": "Swap window {arg:direction}",
        "resizeactive": "Resize window by {arg}",
        "moveactive": "Move window by {arg}",
        "cyclenext": {
            "__default": "Cycle to next window",
            "prev": "Cycle to previous window"
        },
        "swapnext": {
            "__default": "Swap with next window",
            "prev": "Swap with previous window"
        },
        "focuscurrentorlast": "Focus current or last window",
        "focusurgentorlast": "Focus urgent or last window",
        "bringactivetotop": "Bring window to top",
        "alterzorder": "Change window z-order: {arg}",
        "layoutmsg": "Layout: {arg}",
        "togglesplit": "Toggle split direction",
        "splitratio": {
            "__default": "Adjust split ratio",
            "__startsWith:-": "Decrease split ratio",
            "__startsWith:+": "Increase split ratio"
        },
        "togglegroup": "Toggle window group",
        "changegroupactive": "Change active in group: {arg:groupDirection|next}",
        "moveoutofgroup": "Move window out of group",
        "moveintogroup": "Move window into group: {arg:direction}",
        "movewindoworgroup": "Move window or group: {arg:direction}",
        "movegroupwindow": "Move group window: {arg:groupDirection}",
        "lockgroups": "Lock groups: {arg}",
        "lockactivegroup": "Lock active group: {arg}",
        "denywindowfromgroup": "Deny window from group: {arg}",
        "focusmonitor": "Focus monitor: {arg}",
        "movecurrentworkspacetomonitor": "Move workspace to monitor: {arg}",
        "movewindowtomonitor": "Move window to monitor: {arg}",
        "moveworkspacetomonitor": "Move workspace to monitor: {arg}",
        "swapactiveworkspaces": "Swap workspaces between monitors",
        "focusworkspaceoncurrentmonitor": "Focus workspace on current monitor: {arg}",
        "exit": "Exit Hyprland",
        "forcerendererreload": "Force renderer reload",
        "dpms": "Toggle DPMS: {arg|toggle}",
        "exec": "__function:inferFromExec",
        "execr": "__function:inferFromExec",
        "pass": "Pass to: {arg}",
        "submap": "Enter submap: {arg|reset}",
        "global": "__function:inferGlobalShortcut",
        "tagwindow": "Tag window: {arg}",
        "renameworkspace": "Rename workspace: {arg}",
        "movecursortocorner": "Move cursor to corner: {arg}",
        "movecursor": "Move cursor: {arg}",
        "event": "Emit event: {arg}",
        "setprop": "Set property: {arg}",
        "toggleswallow": "Toggle window swallow",
        "setignoregrouplock": "Set ignore group lock: {arg}"
    },
