    "execPatterns": {
        "wpctl": {
            "__contains:set-mute.*toggle": "Toggle mute",
            "__contains:set-volume.*\\+": "Volume up",
            "__contains:set-volume.*-": "Volume down",
            "__contains:set-volume": "Set volume",
            "__contains:set-mute": "Mute",
            "__default": "Audio control"
        },
        "systemctl": {
            "__contains:suspend-then-hibernate": "Suspend then hibernate",
            "__contains:suspend": "Suspend",
            "__contains:hibernate": "Hibernate",
            "__contains:poweroff": "Shutdown",
            "__contains:reboot": "Reboot",
            "__default": "System control"
        }
    },
    "caelestiaPatterns": [
        {
            "match": "screenshot\\s+-r",
            "desc": "Screenshot region"
        },
        {
            "match": "screenshot\\s+-f",
            "desc": "Screenshot (freeze)"
